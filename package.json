{
  "name": "solid-rocket-booster-explorer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Headless educational solid rocket flight simulation",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.app.json",
    "build": "npm run build:core && vite build",
    "build:core": "tsc -p tsconfig.build.json",
    "dev": "vite",
    "preview": "vite preview",
    "demo": "node --import tsx scripts/demo.ts"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.13.4",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "6.1.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans": "5.3.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-is": "18.3.1",
    "recharts": "3.10.1"
  }
}
